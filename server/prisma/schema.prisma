generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id_utilisateur Int    @id @default(autoincrement())
  nom            String @db.VarChar(100)
  prenom         String @db.VarChar(100)
  email          String @unique @db.VarChar(150)
  mot_de_passe   String @db.VarChar(255)
  role           String @default("agriculteur") @db.VarChar(50)

  parcelles    Parcelle[]
  observations Observation[]

  @@map("utilisateur")
}

model Parcelle {
  id_parcelle    Int      @id @default(autoincrement())
  nom            String   @db.VarChar(100)
  surface        Float
  latitude       Float
  longitude      Float
  description    String?  @db.Text
  date_creation  DateTime @default(now()) @db.Date
  id_utilisateur Int

  utilisateur Utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur])
  cultures    Culture[]
  meteo       Meteo[]

  @@map("parcelle")
}

model Culture {
  id_culture         Int      @id @default(autoincrement())
  nom                String   @db.VarChar(100)
  variete            String?  @db.VarChar(100)
  date_semis         DateTime @db.Date
  date_recolte_prevue DateTime? @db.Date
  statut             String   @default("en cours") @db.VarChar(50)
  id_parcelle        Int

  parcelle           Parcelle            @relation(fields: [id_parcelle], references: [id_parcelle])
  observations       Observation[]
  alertes            Alerte[]
  historique         HistoriqueCulture[]

  @@map("culture")
}

model Observation {
  id_observation   Int      @id @default(autoincrement())
  date_observation DateTime @db.Date
  type             String   @db.VarChar(100)
  description      String?  @db.Text
  unite            String?  @db.VarChar(20)
  id_culture       Int
  id_utilisateur   Int

  culture      Culture     @relation(fields: [id_culture], references: [id_culture])
  utilisateur  Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("observation")
}

model Meteo {
  id_meteo      Int      @id @default(autoincrement())
  date_meteo    DateTime @db.Date
  temperature   Float
  humidite      Float
  precipitation Float
  vent          Float
  id_parcelle   Int

  parcelle Parcelle @relation(fields: [id_parcelle], references: [id_parcelle])

  @@map("meteo")
}

model RegleAlerte {
  id_regle         Int    @id @default(autoincrement())
  nom              String @db.VarChar(100)
  parametre        String @db.VarChar(100)
  operateur        String @db.VarChar(10)
  seuil            Float
  niveau           String @db.VarChar(20)
  message_template String @db.Text

  alertes Alerte[]

  @@map("regle_alerte")
}

model Alerte {
  id_alerte   Int      @id @default(autoincrement())
  date_alerte DateTime
  type_alerte String   @db.VarChar(100)
  message     String   @db.Text
  niveau      String   @db.VarChar(20)
  statut      String   @default("active") @db.VarChar(20)
  id_culture  Int
  id_regle    Int

  culture Culture     @relation(fields: [id_culture], references: [id_culture])
  regle   RegleAlerte @relation(fields: [id_regle], references: [id_regle])

  @@map("alerte")
}

model HistoriqueCulture {
  id_historique   Int      @id @default(autoincrement())
  statut          String   @db.VarChar(50)
  date_changement DateTime
  commentaire     String?  @db.Text
  id_culture      Int

  culture Culture @relation(fields: [id_culture], references: [id_culture])

  @@map("historique_culture")
}